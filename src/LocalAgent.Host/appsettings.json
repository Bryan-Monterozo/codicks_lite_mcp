{
  "SchemaVersion": 1,
  "Agent": {
    "Machine": {
      "Id": "auto",
      "DisplayName": "auto"
    },
    "ReadOnly": false,
    "StateDirectory": "~/Library/Application Support/CodicksLiteMcp",
    "Limits": {
      "MaxEditableFileBytes": 1048576,
      "MaxReadResponseBytes": 65536,
      "MaxDirectoryEntries": 200,
      "MaxSearchResults": 100,
      "MaxTraversalDepth": 12,
      "OperationTimeoutSeconds": 15,
      "MaxConcurrentMutations": 1
    },
    "Recovery": {
      "RetentionDays": 30,
      "MaxStorageBytes": 1073741824
    },
    "Logging": {
      "MinimumLevel": "Information"
    },
    "Security": {
      "DenyGlobs": [
        "**/.git",
        "**/.git/**",
        "**/.env",
        "**/.env.*",
        "**/*.pfx",
        "**/*.p12",
        "**/*.key"
      ]
    },
    "Search": {
      "ExcludeGlobs": [
        "**/node_modules/**",
        "**/.dart_tool/**",
        "**/bin/**",
        "**/obj/**",
        "**/build/**",
        "**/coverage/**"
      ]
    },
    "Workspaces": {}
  },
  "Execution": {
    "Enabled": false,
    "MaxTimeoutSeconds": 600,
    "MaxOutputBytes": 262144,
    "Executables": {
      "dotnet": {
        "Enabled": true,
        "AllowAnyArguments": false,
        "AllowedCommands": [
          "build",
          "test",
          "restore"
        ]
      },
      "git": {
        "Enabled": true,
        "AllowAnyArguments": false,
        "AllowedCommands": [
          "status",
          "diff",
          "log"
        ],
        "DeniedCommands": [
          "push",
          "reset"
        ]
      },
      "flutter": {
        "Enabled": true,
        "AllowAnyArguments": true
      },
      "dart": {
        "Enabled": true,
        "AllowAnyArguments": true
      }
    },
    "Sandbox": {
      "Enabled": false,
      "RuntimeExecutable": "container",
      "Image": "mcr.microsoft.com/dotnet/sdk:10.0",
      "CpuCount": 2,
      "MemoryMegabytes": 2048,
      "TmpfsMegabytes": 256,
      "ReadOnlyRoot": true,
      "NetworkEnabled": false
    }
  },
  "SessionSecurity": {
    "DefaultMode": "Locked",
    "DefaultLeaseMinutes": 30,
    "OtpDigits": 6,
    "OtpLifetimeMinutes": 10
  }
}
