{
  "SchemaVersion": 1,
  "Agent": {
    "Machine": {
      "Id": "my-imac",
      "DisplayName": "My iMac"
    },
    "ReadOnly": false,
    "StateDirectory": "~/Library/Application Support/CodicksLiteMcp",
    "Limits": {
      "MaxEditableFileBytes": 1048576,
      "MaxReadResponseBytes": 65536,
      "MaxDirectoryEntries": 200,
      "MaxSearchResults": 100,
      "MaxTraversalDepth": 12,
      "OperationTimeoutSeconds": 15,
      "MaxConcurrentMutations": 1
    },
    "Recovery": {
      "RetentionDays": 30,
      "MaxStorageBytes": 1073741824
    },
    "Logging": {
      "MinimumLevel": "Information"
    },
    "Security": {
      "DenyGlobs": [
        "**/.git",
        "**/.git/**",
        "**/.env",
        "**/.env.*",
        "**/*.pfx",
        "**/*.p12",
        "**/*.key"
      ]
    },
    "Search": {
      "ExcludeGlobs": [
        "**/node_modules/**",
        "**/.dart_tool/**",
        "**/bin/**",
        "**/obj/**",
        "**/build/**",
        "**/coverage/**"
      ]
    },
    "Workspaces": {
      "example-readonly": {
        "Root": "~/Development/ExampleProject",
        "Enabled": false,
        "AllowedOperations": [
          "read"
        ]
      }
    }
  },
  "SessionSecurity": {
    "DefaultMode": "Locked",
    "DefaultLeaseMinutes": 30,
    "OtpDigits": 6,
    "OtpLifetimeMinutes": 10
  }
}
